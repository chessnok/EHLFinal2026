# Copy to .env in the repo root (git-ignored, never commit it). Real environment variables win over this file.

# The arena. One key per team, from https://arena.tacto.ai/apply.
ARENA_URL=https://arena.tacto.ai
ARENA_API_KEY=

# Which model the LLM strategies use: <provider>:<model> (agent/README.md lists the providers).
LLM=openai:<model>
# The key of that provider (one of these), or LLM_BASE_URL + LLM_API_KEY for any OpenAI-compatible endpoint.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# LLM_BASE_URL=
# LLM_API_KEY=

# Langfuse tracing (agent/README.md, Langfuse).
# Keys: Langfuse project -> Settings -> API keys. Host: https://cloud.langfuse.com (EU),
# https://us.cloud.langfuse.com (US), or your own server.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
